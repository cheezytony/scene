# Copy to .env.local. Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Required in production (the API refuses requests without it); optional in development.
# Callers send it in the x-access-code header (the UI has a field for it).
APP_ACCESS_CODE=

# Optional generation tuning (see README "How generation works").
# SCENE_CHUNK_BEATS=3
# SCENE_FAST_MODE=1

# Optional: other AI services. Each is used only if chosen in the app's settings.
# Previews and shot prompts via OpenAI or any compatible service (OPENAI_BASE_URL to point elsewhere):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Rendering the movie:
# GEMINI_API_KEY=        # Google Veo
# REPLICATE_API_TOKEN=   # any Replicate text-to-video model
